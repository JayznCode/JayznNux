#include <stdio.h>
#include <dirent.h> // 디렉토리 관련 시스템 콜을 위한 헤더

int main(int argc, char *argv[]) {
    // 1. 현재 디렉토리(".")를 엽니다.
    DIR *dir = opendir(".");
    
    // 2. 디렉토리를 열 수 없는 경우 (권한 부족 등)
    if (dir == NULL) {
        perror("디렉토리 열기 실패");
        return 1;
    }

    // 3. 디렉토리 내부를 한 줄씩 읽습니다.
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        // 4. 파일 이름을 화면에 출력합니다.
        printf("%s\n", entry->d_name);
    }

    // 5. 작업이 끝나면 디렉토리를 닫습니다.
    closedir(dir);
    
    return 0;
}
